{
  "manifest_version": 2,
  "name": "Claude Browser Agent (unofficial)",
  "short_name": "Claude Agent",
  "version": "0.1.0",
  "description": "Chat with Claude through your Anthropic API key and let it read and operate the open page. Unofficial, not made by Anthropic.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Claude",
    "default_icon": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-browser-agent@makys0.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "websiteActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
