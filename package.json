{
  "name": "apex-gp-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first 3D Formula-style racing simulator (Three.js + custom vehicle physics, Capacitor for Android/iOS)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "android:debug": "bash scripts/build-android.sh debug",
    "android:release": "bash scripts/build-android.sh release",
    "ios:ipa": "bash scripts/build-ios.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
